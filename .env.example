APP_NAME=FreteHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.0

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fretehub
DB_USERNAME=fretehub
DB_PASSWORD=secret

# ── Cache & Sessions (Redis) ───────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=fretehub_

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Queues (Redis) ─────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

# ── Filesystem ─────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@fretehub.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (opcional - diferencial da vaga) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Sanctum ────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8000

# ── Swagger / L5-Swagger ───────────────────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=true

# ── Carrier Mocks ──────────────────────────────────────────────────────────────
# Percentual de chance de falha simulada (0-100)
CARRIER_FAILURE_RATE=5
# TTL do cache de cotações em segundos (padrão: 1 hora)
QUOTE_CACHE_TTL=3600
# Expiração da cotação em minutos
QUOTE_EXPIRES_IN_MINUTES=60

# ── Webhook ────────────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=3
